     </widget>
    </item>
    <item row="1" column="0" rowspan="2" colspan="2">
     <widget class="QTextBrowser" name="textBrowser">
      <property name="html">
       <string>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
hr { height: 1px; border-width: 0; }
li.unchecked::marker { content: &quot;\2610&quot;; }
li.checked::marker { content: &quot;\2612&quot;; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Segoe UI'; font-size:9pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;h3 align=&quot;center&quot; dir='rtl' style=&quot; margin-top:14px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:large; font-weight:700;&quot;&gt;شروط استخدام تطبيق KinSight (نسخة المقالات والارشاد)&lt;/span&gt;&lt;/h3&gt;
&lt;h4 align=&quot;center&quot; dir='rtl' style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'ui-sans-serif','system-ui','sans-serif','Apple Color Emoji','Segoe UI Emoji','Segoe UI Symbol','Noto Color Emoji'; font-size:medium; font-weight:700; color:#ffffff;&quot;&gt;1. طبيعة التطبيق&lt;/span&gt;&lt;/h4&gt;
&lt;p align=&quot;center&quot; dir='rtl' style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; color:#ffffff;&quot;&gt;تطبيق &lt;/span&gt;&lt;span style=&quot; font-weight:700; color:#ffffff;&quot;&gt;KinSight&lt;/span&gt;&lt;span style=&quot; color:#ffffff;&quot;&gt; هو منصة رقمية معرفية تقدم مقالات تربوية وتوجيهية حول كيفية التعامل مع الأطفال في مختلف أعمارهم، والتعريف ببعض الأعراض الصحية للأطفال والرضع.&lt;/span&gt;&lt;/p&gt;
&lt;h4 align=&quot;center&quot; dir='rtl' style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'ui-sans-serif','system-ui','sans-serif','Apple Color Emoji','Segoe UI Emoji','Segoe UI Symbol','Noto Color Emoji'; font-size:medium; font-weight:700; color:#ffffff;&quot;&gt;2. إخلاء المسؤولية (المحتوى المقالي)&lt;/span&gt;&lt;/h4&gt;
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;
&lt;li style=&quot; font-family:'ui-sans-serif','system-ui','sans-serif','Apple Color Emoji','Segoe UI Emoji','Segoe UI Symbol','Noto Color Emoji'; font-size:15px; color:#ffffff;&quot; align=&quot;center&quot; dir='rtl' style=&quot; margin-top:0px; margin-bottom:0px; margin-left:20px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;لغرض المعلومة فقط:&lt;/span&gt; المقالات المنشورة في التطبيق هي مجرد نصائح عامة مستمدة من مراجع تربوية وطبية، ولا يجب اعتبارها &amp;quot;فتوى طبية&amp;quot; أو &amp;quot;تشخيصاً نهائياً&amp;quot;.&lt;/li&gt;
&lt;li style=&quot; font-family:'ui-sans-serif','system-ui','sans-serif','Apple Color Emoji','Segoe UI Emoji','Segoe UI Symbol','Noto Color Emoji'; font-size:15px; color:#ffffff;&quot; align=&quot;center&quot; dir='rtl' style=&quot; margin-top:0px; margin-bottom:0px; margin-left:20px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;استشارة المختصين:&lt;/span&gt; المعلومات المتعلقة بالرضع والأمراض هي لزيادة الوعي فقط. يقر المستخدم بأن التطبيق لا يغني عن مراجعة طبيب الأطفال أو الأخصائي النفسي التربوي عند الضرورة.&lt;/li&gt;
&lt;li style=&quot; font-family:'ui-sans-serif','system-ui','sans-serif','Apple Color Emoji','Segoe UI Emoji','Segoe UI Symbol','Noto Color Emoji'; font-size:15px; color:#ffffff;&quot; align=&quot;center&quot; dir='rtl' style=&quot; margin-top:0px; margin-bottom:0px; margin-left:20px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;تطبيق النصائح:&lt;/span&gt; تظل مسؤولية تطبيق أي نصيحة تربوية أو صحية واردة في المقالات على عاتق الوالدين أو المربي.&lt;/li&gt;&lt;/ul&gt;
&lt;h4 align=&quot;center&quot; dir='rtl' style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'ui-sans-serif','system-ui','sans-serif','Apple Color Emoji','Segoe UI Emoji','Segoe UI Symbol','Noto Color Emoji'; font-size:medium; font-weight:700; color:#ffffff;&quot;&gt;3. الخصوصية وعدم جمع البيانات&lt;/span&gt;&lt;/h4&gt;
&lt;p align=&quot;center&quot; dir='rtl' style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; color:#ffffff;&quot;&gt;نؤكد للمستخدمين أن تطبيق &lt;/span&gt;&lt;span style=&quot; font-weight:700; color:#ffffff;&quot;&gt;KinSight&lt;/span&gt;&lt;span style=&quot; color:#ffffff;&quot;&gt;:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;
&lt;li style=&quot; font-family:'ui-sans-serif','system-ui','sans-serif','Apple Color Emoji','Segoe UI Emoji','Segoe UI Symbol','Noto Color Emoji'; font-size:15px; color:#ffffff;&quot; align=&quot;center&quot; dir='rtl' style=&quot; margin-top:0px; margin-bottom:0px; margin-left:20px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;لا يقوم بجمع أو تخزين أي بيانات شخصية (مثل الاسم، البريد الإلكتروني، أو الصور).&lt;/li&gt;
&lt;li style=&quot; font-family:'ui-sans-serif','system-ui','sans-serif','Apple Color Emoji','Segoe UI Emoji','Segoe UI Symbol','Noto Color Emoji'; font-size:15px; color:#ffffff;&quot; align=&quot;center&quot; dir='rtl' style=&quot; margin-top:0px; margin-bottom:0px; margin-left:20px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;لا يتطلب إنشاء حساب شخصي للوصول إلى المقالات.&lt;/li&gt;
&lt;li style=&quot; font-family:'ui-sans-serif','system-ui','sans-serif','Apple Color Emoji','Segoe UI Emoji','Segoe UI Symbol','Noto Color Emoji'; font-size:15px; color:#ffffff;&quot; align=&quot;center&quot; dir='rtl' style=&quot; margin-top:0px; margin-bottom:0px; margin-left:20px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;لا يتتبع نشاط المستخدم خارج نطاق قراءة المقالات داخل التطبيق.&lt;/li&gt;&lt;/ul&gt;
&lt;h4 align=&quot;center&quot; dir='rtl' style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'ui-sans-serif','system-ui','sans-serif','Apple Color Emoji','Segoe UI Emoji','Segoe UI Symbol','Noto Color Emoji'; font-size:medium; font-weight:700; color:#ffffff;&quot;&gt;4. حقوق الملكية الفكرية&lt;/span&gt;&lt;/h4&gt;
&lt;p align=&quot;center&quot; dir='rtl' style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; color:#ffffff;&quot;&gt;جميع المقالات المنشورة داخل التطبيق هي ثمرة جهد في الإعداد والصياغة. يمنع نسخ هذه المقالات أو إعادة نشرها في تطبيقات أو مواقع أخرى دون الإشارة بوضوح إلى أن المصدر هو تطبيق KinSight.&lt;/span&gt;&lt;/p&gt;
&lt;h4 align=&quot;center&quot; dir='rtl' style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'ui-sans-serif','system-ui','sans-serif','Apple Color Emoji','Segoe UI Emoji','Segoe UI Symbol','Noto Color Emoji'; font-size:medium; font-weight:700; color:#ffffff;&quot;&gt;5. صحة المعلومات&lt;/span&gt;&lt;/h4&gt;
&lt;p align=&quot;center&quot; dir='rtl' style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; color:#ffffff;&quot;&gt;يسعى مطور KinSight إلى توفير معلومات دقيقة وموثوقة، ومع ذلك، لا يضمن التطبيق خلو المقالات من الأخطاء البشرية أو التطورات العلمية المتسارعة في علم تربية الطفل.&lt;/span&gt;&lt;/p&gt;
&lt;h4 align=&quot;center&quot; dir='rtl' style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'ui-sans-serif','system-ui','sans-serif','Apple Color Emoji','Segoe UI Emoji','Segoe UI Symbol','Noto Color Emoji'; font-size:medium; font-weight:700; color:#ffffff;&quot;&gt;6. التغييرات في التطبيق&lt;/span&gt;&lt;/h4&gt;
&lt;p align=&quot;center&quot; dir='rtl' style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; color:#ffffff;&quot;&gt;يحتفظ المطور بالحق في إضافة، حذف، أو تعديل أي مقال في أي وقت دون إشعار مسبق، بما يخدم مصلحة المستخدم وتحديث المعلومات.&lt;/span&gt;&lt;/p&gt;
&lt;h4 align=&quot;center&quot; dir='rtl' style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'ui-sans-serif','system-ui','sans-serif','Apple Color Emoji','Segoe UI Emoji','Segoe UI Symbol','Noto Color Emoji'; font-size:medium; font-weight:700; color:#ffffff;&quot;&gt;7. القانون المعمول به&lt;/span&gt;&lt;/h4&gt;
&lt;p align=&quot;center&quot; dir='rtl' style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; color:#ffffff;&quot;&gt;يخضع هذا التطبيق للقوانين المغربية المتعلقة بالصحافة والنشر والملكية الفكرية.&lt;/span&gt;&lt;/p&gt;
&lt;p align=&quot;center&quot; dir='rtl' style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'ui-sans-serif','system-ui','sans-serif','Apple Color Emoji','Segoe UI Emoji','Segoe UI Symbol','Noto Color Emoji'; font-size:15px; font-weight:700; font-style:italic; color:#ffffff;&quot;&gt;بند المحتوى الآلي والمصادر:&lt;/span&gt;&lt;span style=&quot; font-family:'ui-sans-serif','system-ui','sans-serif','Apple Color Emoji','Segoe UI Emoji','Segoe UI Symbol','Noto Color Emoji'; font-size:15px; font-style:italic; color:#ffffff;&quot;&gt; يتم إعداد المقالات في تطبيق KinSight بمساعدة تقنيات الذكاء الاصطناعي التي تجمع المعلومات من مصادر متعددة. نظراً لطبيعة هذه التقنية، قد لا يتم ذكر جميع المصادر بشكل تفصيلي. يخلي المطور مسؤوليته عن أي خطأ تقني أو علمي قد ينتج عن هذه المعالجة الآلية، ويؤكد أن هذه المقالات لا تعوض استشارة ذوي الاختصاص الطبي والتربوي.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
      </property>
     </widget>
    </item>
   </layout>
  </widget>
